+"""Separate confidently resolved metadata from text similarity, conservatively.
+
+No corpus topic dictionaries, query IDs, labels, or real-clock dependencies.
+Event dates and uncertain/ambiguous person mentions remain semantic content.
+"""
+
+import re
+
+from ..query_understanding.dates import parse_date_spans
+from ..query_understanding.parser import normalize
+from .constraints import EVENT_DATE
+
+
+def similarity_query(parser, query, constraints):
+    text = normalize(query).replace('\u2019', "'")
+    spans = []
+    if constraints.person_mode == 'filter':
+        aliases = [alias for alias, names in parser.aliases.items() if names == {constraints.person}]
+        pattern = '|'.join(re.escape(alias) for alias in sorted(aliases, key=len, reverse=True))
+        mentions = list(re.finditer(rf'(?<!\w)(?:{pattern})(?!\w)', text))
+        # A repeated name may also be the topic of the question. Keep it unless
+        # its single occurrence is already resolved as an explicit sender.
+        if len(mentions) == 1:
+            spans.append(mentions[0].span())
+    if constraints.start_date:
+        # Mask event phrases without changing offsets into the original query.
+        masked = EVENT_DATE.sub(lambda match: ' ' * len(match.group()), text)
+        _, _, warnings, date_spans = parse_date_spans(masked, parser.reference_date)
+        if not warnings:
+            for start, end in date_spans:
+                prefix = re.search(r'\b(?:(?:at\s+the\s+)?(?:early|start|mid|late)(?:\s+of)?\s+)?$', text[:start])
+                if prefix:
+                    start = prefix.start()
+                prep = re.search(r'\b(?:in|on|during|between|from|at)\s+$', text[:start])
+                if prep:
+                    start = prep.start()
+                spans.append((start, end))
+            if constraints.hour_range:
+                spans.extend(match.span() for match in re.finditer(r'\b(?:morning|afternoon|evening|night)\b', masked))
+    if not spans:
+        return query
+    chars = list(text)
+    for start, end in spans:
+        chars[start:end] = ' ' * (end - start)
+    rewritten = ' '.join(''.join(chars).split()).strip(' ,?')
+    # Metadata-only requests still need a nonempty encoder input.
+    return rewritten if re.search(r'\w', rewritten) else query
