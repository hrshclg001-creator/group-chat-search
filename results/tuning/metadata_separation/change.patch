+"""Metadata separation on independent English/Hinglish queries."""
+
+import pytest
+
+from app.query_understanding import QueryParser
+from app.query_understanding.dates import parse_date_spans
+from app.search.constraints import understand_constraints
+from app.search.query_text import similarity_query
+
+
+@pytest.fixture
+def parser():
+    return QueryParser({'reference_date': '2026-09-01', 'timezone': 'Asia/Kolkata',
+                        'participants': [{'name': 'Priya Sharma'}, {'name': 'Rahul Verma'}]})
+
+
+@pytest.mark.parametrize('query,expected', [
+    ('What did Priya say about the library?', 'what did say about the library'),
+    ('Rahul ne pichle mahine library pe kya bola?', 'ne library pe kya bola'),
+    ('Find messages in late February about books', 'find messages about books'),
+    ('Find messages from July 2 to July 5 about books', 'find messages about books'),
+    ('What was said on March 5 about the June trip?', 'what was said about the june trip'),
+    ('What did Priya say yesterday morning about books?', 'what did say about books'),
+    ('last month', 'last month'),
+    ('What about the July vacation?', 'What about the July vacation?'),
+    ("Priya's library fees", "Priya's library fees"),
+    ('What did Priya and Rahul say about books?', 'What did Priya and Rahul say about books?'),
+    ('What did Priya say about Priya?', 'What did Priya say about Priya?'),
+    ('messages on 07/08/2026 about books', 'messages on 07/08/2026 about books'),
+])
+def test_separates_only_resolved_metadata(parser, query, expected):
+    constraints = understand_constraints(parser, query)
+    original = constraints.to_dict()
+    assert similarity_query(parser, query, constraints) == expected
+    assert constraints.to_dict() == original
+
+
+def test_span_parser_ignores_auxiliary_may_and_invalid_dates(parser):
+    text = 'we may discuss books on august 9'
+    start, end, warnings, spans = parse_date_spans(text, parser.reference_date)
+    assert (start, end, warnings) == ('2026-08-09', '2026-08-09', ())
+    assert [text[a:b] for a, b in spans] == ['august 9']
+    assert parse_date_spans('february 30', parser.reference_date)[3] == ()
